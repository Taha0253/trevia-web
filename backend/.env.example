# Copy to backend/.env or backend/.env.local and fill in real values.
# Never commit the populated file — both are already gitignored.
# Loaded automatically on startup via python-dotenv (app/core/config.py);
# production (GCP) has neither file and reads real env vars/secrets instead.

# Database
DATABASE_URL=sqlite:///./trevia.db

# CORS — comma-separated explicit origins (no wildcard; required because
# allow_credentials=True is used).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Notification recipient(s)
ADMIN_EMAIL=admin@trevia.com
CAREERS_EMAIL=careers@trevia.com
CONTACT_NOTIFICATION_EMAIL=support@trevia.in

# SMTP (Gmail example — use an app password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=support@trevia.in
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@trevia.in
SMTP_AUTH=true
SMTP_STARTTLS=true

# Basic in-memory rate limiting for /api/leads and /api/contact
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
